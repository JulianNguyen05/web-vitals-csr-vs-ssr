# Cấu hình triển khai trên VPS — file thật nằm ở /etc/tqmart/deploy.env (ngoài repo, không bị git pull ghi đè).
# Sửa xong chạy lại deploy.sh (đổi DATASET/SHOW_ARCH_LABEL) hoặc install-nginx.sh (đổi tên miền).

# Tên miền phụ cho 2 bản. Tên trung tính để người khảo sát không đoán được kiến trúc.
CSR_HOST=a.tqmart-lab.com
SSR_HOST=b.tqmart-lab.com

# Email nhận thông báo gia hạn chứng chỉ HTTPS (Let's Encrypt).
CERT_EMAIL=ban@example.com

# Ngưỡng dữ liệu: 20 | 500 | 2000 — áp dụng cho CẢ HAI bản trong cùng 1 lần deploy.
DATASET=2000

# 1 = hiện nhãn "(CSR)"/"(SSR)" trên header (đo máy). 0 = ẩn (khảo sát người dùng).
SHOW_ARCH_LABEL=1

# Thư mục mã nguồn và nhánh git.
APP_DIR=/srv/tqmart
BRANCH=main
