{
  "name": "web-vitals-csr-vs-ssr",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "sync": "pnpm --filter \"./packages/data\" run sync",
    "validate": "pnpm --filter @repo/data run validate",
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:csr": "pnpm --filter app-csr run dev",
    "dev:ssr": "pnpm --filter app-ssr run dev",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm --filter @repo/measurement run smoke",
    "build:csr": "pnpm --filter app-csr run build",
    "build:ssr": "pnpm --filter app-ssr run build",
    "start:csr": "pnpm --filter app-csr run preview",
    "start:ssr": "pnpm --filter app-ssr run start",
    "measure": "pnpm --filter @repo/measurement run measure"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.3.4",
      "onFail": "download"
    }
  },
  "type": "module"
}
